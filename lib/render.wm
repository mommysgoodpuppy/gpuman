-- Rendering to a caller-owned GPUCanvasContext. This is the portability seam:
-- SDL, a browser canvas, or another window toolkit can all supply the context.

from "./pipeline.wm" import * as Pipeline;
from js.global import type {
  GPUBindGroup,
  GPUCanvasContext,
  GPUCommandBuffer,
  GPUCommandEncoder,
  GPUDevice,
  GPURenderPassEncoder,
  GPUTexture,
  GPUTextureView
};

record Renderer = {
  context: GPUCanvasContext,
  owned: Pipeline.Pipeline,
  clear: (Number, Number, Number, Number)
};

let configure = (
  context: GPUCanvasContext,
  device: GPUDevice,
  format: String
) => {
  context.configure(JSON{
    device: device,
    format: format,
    alphaMode: "opaque"
  })
};

let createWithClear = (
  device: GPUDevice,
  context: GPUCanvasContext,
  format: String,
  clear: (Number, Number, Number, Number),
  fragment: Gpu.Fragment
) => {
  configure(context, device, format) :> Result.andThen((_) => {
    Pipeline.create(device, format, fragment) :> Result.map((owned) => {
      .{ context, owned, clear }
    })
  })
};

let create = (
  device: GPUDevice,
  context: GPUCanvasContext,
  format: String,
  fragment: Gpu.Fragment
) => {
  createWithClear(device, context, format, (0, 0, 0, 1), fragment)
};

let draw = (renderer: Renderer, fragment: Gpu.Fragment) => {
  let device: GPUDevice = renderer.owned.device;
  let context: GPUCanvasContext = renderer.context;
  Pipeline.upload(renderer.owned, fragment) :> Result.andThen((_) => {
    let prepare = Monad.via Result (texture, encoder, group) => {
      texture.createView() :> Result.andThen((view) => {
        let (red, green, blue, alpha) = renderer.clear;
        encoder.beginRenderPass(JSON{
          colorAttachments: JSON[JSON{
            view: view,
            loadOp: "clear",
            storeOp: "store",
            clearValue: JSON{ r: red, g: green, b: blue, a: alpha }
          }]
        }) :> Result.andThen((pass) => {
          pass.setPipeline(renderer.owned.pipeline)
            :> Result.andThen((_) => {
              match(group) {
                Some(value) => { pass.setBindGroup(0, Some(value)) },
                None => { Ok(void) },
              }
            })
            :> Result.andThen((_) => { pass.draw(3, 1, 0, 0) })
            :> Result.andThen((_) => { pass.end() })
            :> Result.andThen((_) => { encoder.finish() })
        })
      })
    };
    Result|
      context.getCurrentTexture(),
      device.createCommandEncoder(),
      Pipeline.bindGroup(renderer.owned, fragment)
    | :> prepare :> Result.andThen((commands) => {
      device.queue :> Result.andThen((queue) => {
        queue.submit(JSON[commands])
      })
    })
  })
};

let destroy = (renderer: Renderer) => {
  let context: GPUCanvasContext = renderer.context;
  Result|Pipeline.destroy(renderer.owned), context.unconfigure()|
    :> Result.map((_) => { void })
};
